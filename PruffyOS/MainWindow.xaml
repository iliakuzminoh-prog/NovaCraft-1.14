<Window x:Class="PruﬀyOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pruﬀy OS"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Background="#070A11"
        ShowInTaskbar="True"
        MinWidth="1024"
        MinHeight="640">
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" BlurRadius="34" ShadowDepth="0" Opacity="0.42" Color="#000000"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AAB6CE"/>
            <Setter Property="Background" Value="#101625"/>
            <Setter Property="BorderBrush" Value="#1D2840"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18233A"/>
                    <Setter Property="Foreground" Value="#F5F7FF"/>
                    <Setter Property="BorderBrush" Value="#34466D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F7F9FF"/>
            <Setter Property="Background" Value="#6D7CFF"/>
            <Setter Property="BorderBrush" Value="#8995FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8290FF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#5B69E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#141D30"/>
            <Setter Property="BorderBrush" Value="#2A3858"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Built-in Pruﬀy Aurora wallpaper: vector-only, no external downloads. -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#070A11" Offset="0"/>
                    <GradientStop Color="#0A1020" Offset="0.48"/>
                    <GradientStop Color="#11132B" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="220,-330,0,0" Opacity="0.18">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#7C83FF" Offset="0"/><GradientStop Color="#4B57D8" Offset="0.35"/><GradientStop Color="#10152B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="620" Height="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-290" Opacity="0.14">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#35D9C3" Offset="0"/><GradientStop Color="#168B83" Offset="0.4"/><GradientStop Color="#0B101D" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Path Data="M0,620 C260,460 410,720 680,550 C900,410 1110,510 1500,250 L1500,900 L0,900 Z" Fill="#7A82FF" Opacity="0.035"/>
            <Path Data="M0,680 C280,520 420,770 700,610 C960,460 1160,570 1600,330" Stroke="#86D9FF" StrokeThickness="1" Opacity="0.13" Fill="Transparent"/>
        </Grid>

        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Glass top bar -->
            <Border Grid.Row="0" Background="#D90D1423" BorderBrush="#26324D" BorderThickness="1" CornerRadius="20" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="13" Background="#202B4B" BorderBrush="#5263A4" BorderThickness="1">
                            <TextBlock Text="P" FontSize="22" FontWeight="Bold" Foreground="#8793FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Pruﬀy" FontSize="17" FontWeight="SemiBold" Foreground="#F4F7FF"/>
                            <TextBlock Text="temporary desktop" FontSize="10" Foreground="#75829B"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="360" Height="40" CornerRadius="13" Background="#0E1525" BorderBrush="#25324D" BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#E8ECF8" FontSize="13" Padding="15,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Поиск приложений и действий…" Foreground="#596781" FontSize="13" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" FontSize="15" FontWeight="SemiBold" Foreground="#DDE4F5" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="—" Width="38" Height="36" Style="{StaticResource QuietButton}" Click="Minimize_Click" Margin="0,0,7,0"/>
                        <Button Content="×" Width="38" Height="36" Style="{StaticResource QuietButton}" Click="Exit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation -->
                <Border Grid.Column="0" Background="#D90D1423" BorderBrush="#202B43" BorderThickness="1" CornerRadius="22" Padding="12" Effect="{StaticResource Shadow}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="#0E2B29" BorderBrush="#1A5B52" BorderThickness="1" CornerRadius="15" Padding="12" Margin="0,10,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#4DE0C8" VerticalAlignment="Center"/>
                                        <TextBlock Text="  БЕЗОПАСНЫЙ РЕЖИМ" FontSize="9" FontWeight="Bold" Foreground="#9BE9DD" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Работает как обычное приложение" FontSize="11" Foreground="#789D99" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="9" FontWeight="Bold" Foreground="#596780" Margin="10,4,0,12"/>
                            <Button Content="⌂   Главная" Style="{StaticResource NavButton}" Background="#202A49" Foreground="#F5F7FF" BorderBrush="#3B4E7F"/>
                            <Button Content="▦   Приложения" Style="{StaticResource NavButton}" Click="Apps_Click"/>
                            <Button Content="▣   Файлы" Style="{StaticResource NavButton}" Click="Files_Click"/>
                            <Button Content="⚙   Настройки" Style="{StaticResource NavButton}" Click="Settings_Click"/>
                            <Separator Margin="8,9" Background="#24304A"/>
                            <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" FontSize="9" FontWeight="Bold" Foreground="#596780" Margin="10,2,0,12"/>
                            <Button Content="◉   Диспетчер задач" Style="{StaticResource NavButton}" Click="TaskManager_Click"/>
                            <Button Content="□   Калькулятор" Style="{StaticResource NavButton}" Click="Calculator_Click"/>
                            <Button Content="✎   Блокнот" Style="{StaticResource NavButton}" Click="Notepad_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Main canvas -->
                <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,4,4,30">
                        <TextBlock Text="Добро пожаловать" FontSize="34" FontWeight="SemiBold" Foreground="#F5F7FF"/>
                        <TextBlock Text="Pruﬀy — временный красивый слой поверх Windows, который можно закрыть в любой момент." FontSize="13" Foreground="#7F8CA5" Margin="0,6,0,20"/>

                        <Grid Height="246">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.05*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="25" BorderBrush="#394A77" BorderThickness="1" Effect="{StaticResource Shadow}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#252E58" Offset="0"/>
                                        <GradientStop Color="#151D38" Offset="0.62"/>
                                        <GradientStop Color="#101727" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid Margin="27">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PRUFFY AURORA" FontSize="10" FontWeight="Bold" Foreground="#6DE3D2"/>
                                        <TextBlock Text="Твой рабочий экран." FontSize="32" FontWeight="SemiBold" Foreground="#F7F9FF" Margin="0,8,0,0"/>
                                        <TextBlock Text="Обои встроены. Интернет не нужен. Система Windows остаётся под ними." FontSize="13" Foreground="#AAB5CC" Margin="0,7,0,0" MaxWidth="620" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <Button Content="Открыть браузер" Style="{StaticResource ActionButton}" Click="Browser_Click" Margin="0,0,9,0"/>
                                        <Button Content="Открыть файлы" Style="{StaticResource QuietButton}" Click="Files_Click" Margin="0,0,9,0"/>
                                        <Button Content="Настроить" Style="{StaticResource QuietButton}" Click="Settings_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Margin="15,0,0,0" CornerRadius="25" Background="#D90D1423" BorderBrush="#25314C" BorderThickness="1" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="СИСТЕМА" FontSize="10" FontWeight="Bold" Foreground="#64728C"/>
                                    <TextBlock Text="Pruﬀy online" FontSize="23" FontWeight="SemiBold" Foreground="#F3F6FF" Margin="0,9,0,2"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,17">
                                        <Ellipse Width="8" Height="8" Fill="#4DE0C8" VerticalAlignment="Center"/>
                                        <TextBlock Text="  локальный интерфейс" FontSize="11" Foreground="#7FA9A3"/>
                                    </StackPanel>
                                    <Border Background="#10182A" CornerRadius="13" Padding="12" Margin="0,0,0,8">
                                        <Grid><TextBlock Text="Сеть" Foreground="#7B879F"/><TextBlock Text="не используется" HorizontalAlignment="Right" Foreground="#D7DEED"/></Grid>
                                    </Border>
                                    <Border Background="#10182A" CornerRadius="13" Padding="12" Margin="0,0,0,8">
                                        <Grid><TextBlock Text="Права" Foreground="#7B879F"/><TextBlock Text="обычные" HorizontalAlignment="Right" Foreground="#D7DEED"/></Grid>
                                    </Border>
                                    <Border Background="#10182A" CornerRadius="13" Padding="12">
                                        <Grid><TextBlock Text="Выход" Foreground="#7B879F"/><TextBlock Text="возвратит Windows" HorizontalAlignment="Right" Foreground="#D7DEED"/></Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Быстрый доступ" FontSize="19" FontWeight="SemiBold" Foreground="#F4F7FF" Margin="0,23,0,12"/>
                        <UniformGrid Columns="4">
                            <Border Height="138" Margin="0,0,9,0" CornerRadius="19" Background="#D90D1423" BorderBrush="#202B43" BorderThickness="1" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="Браузер" FontSize="15" FontWeight="SemiBold" Foreground="#F4F7FF"/>
                                    <TextBlock Text="Веб в один клик" FontSize="11" Foreground="#75829B" Margin="0,6,0,13"/>
                                    <Button Content="Запустить" Style="{StaticResource QuietButton}" Height="33" Click="Browser_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Height="138" Margin="3,0,6,0" CornerRadius="19" Background="#D90D1423" BorderBrush="#202B43" BorderThickness="1" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="Проводник" FontSize="15" FontWeight="SemiBold" Foreground="#F4F7FF"/>
                                    <TextBlock Text="Файлы и диски" FontSize="11" Foreground="#75829B" Margin="0,6,0,13"/>
                                    <Button Content="Открыть" Style="{StaticResource QuietButton}" Height="33" Click="Files_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Height="138" Margin="6,0,3,0" CornerRadius="19" Background="#D90D1423" BorderBrush="#202B43" BorderThickness="1" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="Настройки" FontSize="15" FontWeight="SemiBold" Foreground="#F4F7FF"/>
                                    <TextBlock Text="Параметры Windows" FontSize="11" Foreground="#75829B" Margin="0,6,0,13"/>
                                    <Button Content="Открыть" Style="{StaticResource QuietButton}" Height="33" Click="Settings_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Height="138" Margin="9,0,0,0" CornerRadius="19" Background="#D90D1423" BorderBrush="#202B43" BorderThickness="1" Padding="17">
                                <StackPanel>
                                    <TextBlock Text="Диспетчер" FontSize="15" FontWeight="SemiBold" Foreground="#F4F7FF"/>
                                    <TextBlock Text="Процессы Windows" FontSize="11" Foreground="#75829B" Margin="0,6,0,13"/>
                                    <Button Content="Открыть" Style="{StaticResource QuietButton}" Height="33" Click="TaskManager_Click"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Margin="0,18,0,0" CornerRadius="19" Background="#A90D1423" BorderBrush="#202B43" BorderThickness="1" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pruﬀy Promise" FontSize="14" FontWeight="SemiBold" Foreground="#F3F6FF"/>
                                    <TextBlock Text="Никакой замены оболочки Windows, автозапуска или скрытых фоновых служб." FontSize="11" Foreground="#75829B" Margin="0,5,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Закрыть Pruﬀy" Style="{StaticResource ActionButton}" Background="#2A3148" BorderBrush="#3A4665" Click="Exit_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>