<Window x:Class="PruffyOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pruﬀy OS"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B50D111C" BorderBrush="#26324B" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#202A48">
                        <TextBlock Text="P" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Pruﬀy OS" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Temporary desktop interface" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ClockText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="—" Width="46" Height="38" Margin="0,0,8,0" Click="Minimize_Click"/>
                    <Button Content="Закрыть" Height="38" Click="Exit_Click" Background="#321E2A" BorderBrush="#5D3040"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="22" BorderBrush="#202B43" BorderThickness="1" Padding="14" Effect="{StaticResource CardShadow}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <TextBlock Text="Безопасный режим" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,7"/>
                        <Border Background="#112D2B" BorderBrush="#1D5D54" BorderThickness="1" CornerRadius="12" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent2Brush}" VerticalAlignment="Center"/>
                                <TextBlock Text="  Ничего не меняет систему" Foreground="#BCEFE7" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel>
                        <Button Content="Главная" Height="48" HorizontalContentAlignment="Left" Margin="0,0,0,8" Background="#202A48" BorderBrush="#3C4D7D"/>
                        <Button Content="Приложения" Height="48" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Apps_Click"/>
                        <Button Content="Файлы" Height="48" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Files_Click"/>
                        <Button Content="Настройки Windows" Height="48" HorizontalContentAlignment="Left" Click="Settings_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Margin="22,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Добро пожаловать" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Это временная оболочка-интерфейс. Windows продолжает работать как обычно." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,22"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="210" CornerRadius="24" Background="#1B2540" BorderBrush="#35466F" BorderThickness="1" Effect="{StaticResource CardShadow}">
                            <Grid Margin="26">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Pruﬀy Space" FontSize="15" Foreground="{StaticResource Accent2Brush}"/>
                                    <TextBlock Text="Красивый рабочий экран&#10;без изменений системы." FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <Button Content="Открыть браузер" Click="Browser_Click" Margin="0,0,10,0"/>
                                    <Button Content="Проводник" Click="Files_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Margin="16,0,0,0" Height="210" CornerRadius="24" Background="{StaticResource Panel2Brush}" BorderBrush="#26334E" BorderThickness="1" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Состояние" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="Готово" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Accent2Brush}" Margin="0,10,0,4"/>
                                <TextBlock Text="Локальный интерфейс&#10;Сеть не используется&#10;Админ-права не требуются" FontSize="13" Foreground="{StaticResource TextBrush}" LineHeight="22"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Быстрый доступ" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3" Rows="1">
                        <Border Height="130" Margin="0,0,10,0" CornerRadius="20" Background="{StaticResource PanelBrush}" BorderBrush="#202B43" BorderThickness="1" Padding="18">
                            <StackPanel><TextBlock Text="Браузер" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Открыть браузер Windows" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/><Button Content="Запустить" Height="34" Click="Browser_Click"/></StackPanel>
                        </Border>
                        <Border Height="130" Margin="5,0" CornerRadius="20" Background="{StaticResource PanelBrush}" BorderBrush="#202B43" BorderThickness="1" Padding="18">
                            <StackPanel><TextBlock Text="Файлы" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Открыть Проводник" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/><Button Content="Запустить" Height="34" Click="Files_Click"/></StackPanel>
                        </Border>
                        <Border Height="130" Margin="10,0,0,0" CornerRadius="20" Background="{StaticResource PanelBrush}" BorderBrush="#202B43" BorderThickness="1" Padding="18">
                            <StackPanel><TextBlock Text="Windows" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Системные настройки" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,12"/><Button Content="Открыть" Height="34" Click="Settings_Click"/></StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Text="Pruﬀy OS работает как обычное приложение: закрытие возвращает тебя к обычному рабочему столу Windows." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,30"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>