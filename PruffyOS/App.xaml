<Application x:Class="PruffyOS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0A0D16" Offset="0"/>
            <GradientStop Color="#111A2B" Offset="0.52"/>
            <GradientStop Color="#090B12" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#CC121827"/>
        <SolidColorBrush x:Key="Panel2Brush" Color="#B3161E31"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F3F6FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#91A0BA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7C8CFF"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="#4DE0C8"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#182137"/>
            <Setter Property="BorderBrush" Value="#2B3958"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#233052"/>
                    <Setter Property="BorderBrush" Value="#596C9D"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2B3B63"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>